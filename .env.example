APP_NAME="Violet Finance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://finance.technologytime.org
APP_TIMEZONE=Europe/Istanbul

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL database created in CloudPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=violet_finance
DB_USERNAME=violet_finance
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# First administrator (used once by: php artisan migrate --seed)
ADMIN_EMAIL=admin@violet.local
ADMIN_PASSWORD=ChangeMe!2026

# PDF engine (wkhtmltopdf 0.12.6.1 with patched qt)
WKHTMLTOPDF_BIN=/usr/local/bin/wkhtmltopdf

# E-mail: notifications to signers + sending the uploader file.
# Keep MAIL_MAILER=log to switch e-mails off.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="finance@violetsyria.org"
MAIL_FROM_NAME="${APP_NAME}"
